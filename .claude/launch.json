{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "prototype"],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "site-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "start", "--", "--port", "3100", "--hostname", "0.0.0.0"],
      "port": 3100
    },
    {
      "name": "site-prod-3200",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "start", "--", "--port", "3200"],
      "port": 3200
    },
    {
      "name": "site-prod-3300",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "start", "--", "--port", "3300", "--hostname", "0.0.0.0"],
      "port": 3300
    }
  ]
}
