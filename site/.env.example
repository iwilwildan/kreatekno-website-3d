# Copy to .env.local for local development. Set the same keys in Vercel.
NEXT_PUBLIC_SITE_URL=https://kreatekno.com
# International format, digits only, e.g. 62812xxxxxxx. Empty = wa.me lets the visitor pick a contact.
NEXT_PUBLIC_WA_NUMBER=
# Full public profile URL, e.g. https://www.instagram.com/kreatekno
NEXT_PUBLIC_INSTAGRAM_URL=
# Public inbox used by the Solutions contact dialog.
NEXT_PUBLIC_CONTACT_EMAIL=
